# Copia este archivo como ".env" (o configura estas variables en tu servicio de hosting)

# Puerto del servidor (en Railway/Render/Heroku lo asigna la plataforma)
PORT=3000

# Secreto para firmar las sesiones (pon una frase larga y aleatoria, SOLO tuya)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Cuenta de administradora (Mell). Se crea sola la primera vez que arranca el servidor.
ADMIN_EMAIL=eeuumely@gmail.com
ADMIN_PASSWORD=pon-aqui-la-contrasena-de-administradora
ADMIN_NAME=Mell

# Carpeta donde se guardan los datos (base de datos JSON + archivos adjuntos).
# En servicios con disco persistente (Railway con volumen, Render con disco, VPS)
# apunta a la ruta del disco. Si no se define, usa ./data dentro del proyecto.
DATA_DIR=

# Tamaño máximo por archivo adjunto, en MB
MAX_FILE_MB=25
